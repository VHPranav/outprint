# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# WhatsApp business number that "submit to us" flows (configurator, cart,
# hire-a-designer) deep-link to. Digits only, country code first, no "+" or
# spaces (e.g. 919876543210 for a +91 98765 43210 number). Used client-side
# by lib/whatsapp.ts, so it must be NEXT_PUBLIC_-prefixed.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Cloudinary cloud name, from your Cloudinary dashboard. Used client-side by
# lib/upload.ts for direct unsigned browser uploads (no server code, no API
# secret involved).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Cloudinary unsigned upload preset name (Settings → Upload → Upload
# presets → add an "Unsigned" preset). Controls what folder/transformations
# uploaded design files get, without exposing your API secret to the browser.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Canonical production URL (no trailing slash), used to build absolute URLs
# in app/sitemap.ts. Falls back to https://outprint.co if unset.
NEXT_PUBLIC_SITE_URL=
